# Copy to apps/mobile/.env (gitignored) and restart Expo (`bunx expo start -c`).

# The Visus API. On your phone, use your Mac's Wi-Fi IP, not localhost:
#   1. Server: cd apps/server && bun run dev:phone      (listens on 0.0.0.0:8787)
#   2. Mac's IP: ipconfig getifaddr en0                  (e.g. 192.168.1.20)
#   3. Phone and Mac on the same Wi-Fi.
# Deployed: https://visus-api.<your-subdomain>.workers.dev
EXPO_PUBLIC_API_URL=http://192.168.1.20:8787

# 1 = mock data, no server needed (screens work offline from services/mock/).
EXPO_PUBLIC_USE_MOCK=0

# The web app: report links, terms and privacy pages.
EXPO_PUBLIC_WEB_URL=https://visus.app
