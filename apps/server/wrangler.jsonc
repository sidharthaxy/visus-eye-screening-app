{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visus-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Report links from POST /sessions/:id/share point here.
    "WEB_URL": "https://visus.app"
  },
  "observability": { "enabled": true }
  // Production database: create a Hyperdrive config for the Aiven URL, then add:
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<id from `bunx wrangler hyperdrive create`>" }]
}
